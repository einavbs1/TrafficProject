    ("s_to_center", 2),
    ("s_to_center", 3),
    ("w_to_center", 0),
    ("w_to_center", 1),
    ("w_to_center", 2),
    ("w_to_center", 3),
)
_FOUR_LANE_TURNS: dict[str, dict[int, tuple[str, int]]] = {
    "s_to_center": {
        0: ("center_to_e", 0),
