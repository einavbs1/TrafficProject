_FOUR_LANE_APPROACHES = ("n_to_center", "e_to_center", "s_to_center", "w_to_center")
_CENTER_EXITS = ("center_to_n", "center_to_s", "center_to_e", "center_to_w")
_SIXTEEN_LANE_LINK_ORDER: tuple[tuple[str, int], ...] = (
    ("n_to_center", 0),
    ("n_to_center", 1),
    ("n_to_center", 2),
    ("n_to_center", 3),
