{"event": "session_start", "timestamp": "2026-06-09T00:33:30+03:00", "map_name": "Default (4-lane intersection)", "episodes_planned": 500, "policy_path": "C:\\Users\\Einavs_PC\\Documents\\TrafficProject\\data\\maps\\flowgrid\\dqn_policy.pth", "config_path": "C:\\Users\\Einavs_PC\\Documents\\TrafficProject\\data\\defaults\\dqn_policy_config.yaml", "objectives": {"primary": "Maximize throughput and frequent control decisions to prevent starvation and enable early gap-out", "secondary": ["Minimize waiting time for all vehicles, with modest extra weight for bus and emergency", "Reward vehicles that clear the intersection (throughput-first flow)", "Balance wait across N, S, E, W without overpowering delay", "Avoid queue spillback without freezing the signal (proportional penalties)"], "enforced_outside_rl": ["Action masking — agent cannot select illegal phase switches", "Phase ring: N_ALL → S_ALL → E_ALL → W_ALL (thru + left per arm, not dual-left splits)", "Dynamic min green: max(safety_min, min(min_green_cap, cars*sec_per_car)) — cap is a floor, not fixed phase length", "Agent may hold green longer than min green cap unless max_green is set", "Baseline compare: fixed seconds per phase; DQN compare reloads identical snapshot traffic", "Bulk-first actuated switching when switching is allowed", "Bus/emergency: next green when switching (min green respected); no instant phase cut"]}, "reward_weights": {"delay_delta_scale": 1.0, "total_wait_scale": 0.001, "drain_bonus_per_vehicle": 2.0, "drain_bonus_fleet_drop": 1.0, "fairness_cap": 500.0, "transit_delay_multiplier": 1.0, "transit_priority_scale": 0.4, "emergency_priority_scale": 0.35, "spillback_penalty": -1000.0, "throughput_per_vehicle": 8.0, "fairness_imbalance_weight": -0.1, "starving_arms_weight": -0.4, "inactive_wait_weight": -0.05, "inactive_wait_threshold": 30.0, "switch_penalty": -1.0, "invalid_action_penalty": -8.0}, "constraints": {"min_green_base_seconds": 5.0, "min_green_cap_seconds": 60.0, "absolute_safety_min_seconds": 4.0, "sec_per_car": 2.5, "switch_min_vehicles": 3, "switch_min_wait_seconds": 25.0, "demand_ratio_to_preempt": 0.4, "queue_threshold": 1}, "training_device_preference": "auto", "training_device": "privateuseone:0", "training_device_label": "directml"}
