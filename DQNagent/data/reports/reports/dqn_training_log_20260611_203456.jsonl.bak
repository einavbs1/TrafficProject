in_seconds": 4.0, "sec_per_car": 2.5, "switch_min_vehicles": 3, "switch_min_wait_seconds": 25.0, "demand_ratio_to_preempt": 0.4, "queue_threshold": 1}, "training_device_preference": "auto", "training_device": "privateuseone:0", "training_device_label": "directml"}
